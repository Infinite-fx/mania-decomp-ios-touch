diff --git a/RSDKv5/RSDK/Graphics/SDL2/SDL2RenderDevice.cpp b/RSDKv5/RSDK/Graphics/SDL2/SDL2RenderDevice.cpp
index 82a9b0f..3a0aef7 100644
--- a/RSDKv5/RSDK/Graphics/SDL2/SDL2RenderDevice.cpp
+++ b/RSDKv5/RSDK/Graphics/SDL2/SDL2RenderDevice.cpp
@@ -43,6 +43,33 @@ bool RenderDevice::Init()
     videoSettings.windowWidth  = 1920;
     videoSettings.windowHeight = 1080;
     flags |= SDL_WINDOW_FULLSCREEN;
+#elif RETRO_PLATFORM == RETRO_iOS
+    SDL_SetHint(SDL_HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight");
+    SDL_SetHint(SDL_HINT_IOS_HIDE_HOME_INDICATOR, "2"); // dim the home bar, first swipe only reveals it
+    SDL_SetHint(SDL_HINT_AUDIO_CATEGORY, "playback");   // sound even with the silent switch on
+    SDL_SetHint(SDL_HINT_ACCELEROMETER_AS_JOYSTICK, "0"); // otherwise the phone itself shows up as a "gamepad"
+
+    customSettings.maxPixWidth = 0; // use the whole (wide) screen, like the android port
+
+    videoSettings.windowed    = false;
+    videoSettings.exclusiveFS = false;
+    videoSettings.bordered    = true;
+
+    SDL_DisplayMode dm;
+    SDL_GetDesktopDisplayMode(0, &dm);
+    int32 longSide  = dm.w > dm.h ? dm.w : dm.h;
+    int32 shortSide = dm.w > dm.h ? dm.h : dm.w;
+    videoSettings.windowWidth  = longSide;
+    videoSettings.windowHeight = shortSide;
+    flags |= SDL_WINDOW_FULLSCREEN | SDL_WINDOW_BORDERLESS;
+
+    // game width follows the screen's aspect ratio (e.g. 520x240 on a 19.5:9 iPhone), so pixels stay square
+    videoSettings.pixHeight = SCREEN_YSIZE;
+    videoSettings.pixWidth  = ((int32)((float)SCREEN_YSIZE * longSide / shortSide) + 3) & ~3;
+    if (videoSettings.pixWidth < DEFAULT_PIXWIDTH) // 4:3 iPads: keep the original 424px width (letterboxed) instead of a narrower game
+        videoSettings.pixWidth = DEFAULT_PIXWIDTH;
+    if (videoSettings.pixWidth > SCREEN_XMAX)
+        videoSettings.pixWidth = SCREEN_XMAX;
 #endif
 
     SDL_SetHint(SDL_HINT_RENDER_SCALE_QUALITY, "nearest");
