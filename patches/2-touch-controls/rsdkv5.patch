diff --git a/RSDKv5/RSDK/Input/Touch/TouchInputDevice.cpp b/RSDKv5/RSDK/Input/Touch/TouchInputDevice.cpp
new file mode 100644
index 0000000..f36655f
--- /dev/null
+++ b/RSDKv5/RSDK/Input/Touch/TouchInputDevice.cpp
@@ -0,0 +1,916 @@
+// On-screen touch controls (iOS build).
+//
+// Layout (landscape):
+//   left half of the screen  -> floating d-pad (appears where the thumb lands, follows it)
+//   right half of the screen -> jump (the whole half is a jump zone, the drawn button is just a guide)
+//   contextual button        -> appears above the jump button only when it can be used:
+//                               super form (gold star) / encore character swap (cyan arrows)
+//   top-right                -> pause, replaced by "skip" while a cutscene can be skipped
+//   top-left                 -> back, only in menus
+// Mini-games get their own layouts (mean bean: two rotate buttons, pinball: two flipper halves).
+// Touches that don't hit a control are passed to the game untouched, so menus keep native touch support.
+// When a physical gamepad / keyboard is used the overlay fades out; touching the screen brings it back.
+
+#include "MobileTouchHints.h"
+#include <math.h>
+
+MobileTouchHints mobileTouchHints = {};
+
+namespace
+{
+
+enum TouchCtrlIDs {
+    TCTRL_NONE = -1,
+    TCTRL_DPAD,
+    TCTRL_JUMP,
+    TCTRL_ACTION,
+    TCTRL_PAUSE,
+    TCTRL_SKIP,
+    TCTRL_BACK,
+    TCTRL_FLIPL,
+    TCTRL_FLIPR,
+    TCTRL_COUNT,
+};
+
+enum TouchIcons {
+    TICON_NONE,
+    TICON_SUPER,
+    TICON_SWAP,
+    TICON_ROTATE_CW,
+    TICON_ROTATE_CCW,
+    TICON_JUMP,
+};
+
+struct TouchControl {
+    float x, y, r; // layout, output pixels
+    float hitR;
+    bool visible; // target visibility
+    float alpha;  // animated visibility
+    float press;  // animated press amount
+    bool held;
+    int32 icon;
+    float flash; // short highlight when it appears
+};
+
+struct TouchFinger {
+    SDL_FingerID id;
+    int32 ctrl;
+    float nx, ny; // normalized (0..1)
+    bool alive;
+};
+
+#define TOUCH_MAX_FINGERS (10)
+#define TOUCH_MAX_VERTS   (24000)
+
+TouchControl tCtrl[TCTRL_COUNT];
+TouchFinger tFinger[TOUCH_MAX_FINGERS];
+int32 tFingerCount = 0;
+
+float tScrW = 2532.0f, tScrH = 1170.0f; // output size, updated every draw
+
+RSDK::SKU::InputDeviceTouch *tDevice = nullptr;
+
+int32 tMode         = MTOUCH_MODE_NONE;
+bool tPlaying       = false;
+bool tPadMode       = false; // a physical controller is driving player 1
+float tPadFade      = 1.0f;  // 1 = overlay shown, 0 = hidden for gamepad
+float tActivity     = 1.0f;  // dims the overlay a bit while not touched
+int32 tIdleTimer    = 0;
+int32 tNotPlayTimer = 1000;
+uint32 tTime        = 0;
+
+float tDpadRestX = 0, tDpadRestY = 0;
+float tDpadX = 0, tDpadY = 0; // live center
+float tKnobX = 0, tKnobY = 0; // knob offset from center
+uint8 tDpadDir = 0;           // 1 up, 2 down, 4 left, 8 right
+bool tDpadAnchored = false;
+bool tActionReady  = true;  // swap button is dimmed while swapping isn't possible right now
+float tActionDim   = 1.0f;
+
+inline bool HintActive(unsigned int mark, unsigned int window)
+{
+    return (unsigned int)(mobileTouchHints.frame - mark) <= window;
+}
+
+inline float Approach(float v, float target, float speed)
+{
+    if (v < target)
+        return fminf(v + speed, target);
+    return fmaxf(v - speed, target);
+}
+
+inline float Clamp01(float v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }
+
+inline float EaseOutBack(float t)
+{
+    const float c1 = 1.70158f, c3 = c1 + 1.0f;
+    float u = t - 1.0f;
+    return 1.0f + c3 * u * u * u + c1 * u * u;
+}
+
+void TouchLayout()
+{
+    float W = tScrW, H = tScrH;
+    float u      = H;
+    float sideIn = W * 0.055f; // notch / rounded corners
+    float botIn  = H * 0.06f;  // home indicator
+
+    TouchControl *c;
+
+    c       = &tCtrl[TCTRL_DPAD];
+    c->r    = 0.19f * u; // half length of an arm
+    c->x    = sideIn + 0.23f * u;
+    c->y    = H - botIn - 0.23f * u;
+    c->hitR = c->r * 1.6f;
+
+    tDpadRestX = c->x;
+    tDpadRestY = c->y;
+
+    c       = &tCtrl[TCTRL_JUMP];
+    c->r    = 0.13f * u;
+    c->x    = W - sideIn - 0.195f * u;
+    c->y    = H - botIn - 0.195f * u;
+    c->hitR = c->r * 1.3f;
+
+    TouchControl *jump = c;
+    c                  = &tCtrl[TCTRL_ACTION];
+    c->r               = 0.065f * u;
+    c->x               = jump->x + 0.12f * u;
+    c->y               = jump->y - 0.25f * u;
+    c->hitR            = c->r * 1.5f;
+
+    c       = &tCtrl[TCTRL_PAUSE];
+    c->r    = 0.06f * u;
+    c->x    = W - sideIn - 0.06f * u;
+    c->y    = 0.09f * u;
+    c->hitR = c->r * 1.8f;
+
+    c       = &tCtrl[TCTRL_SKIP];
+    c->r    = 0.065f * u;
+    c->x    = W - sideIn - 0.075f * u;
+    c->y    = 0.1f * u;
+    c->hitR = c->r * 1.6f;
+
+    c       = &tCtrl[TCTRL_BACK];
+    c->r    = 0.055f * u;
+    c->x    = sideIn + 0.065f * u;
+    c->y    = 0.09f * u;
+    c->hitR = c->r * 1.7f;
+
+    c       = &tCtrl[TCTRL_FLIPL];
+    c->r    = 0.14f * u;
+    c->x    = sideIn + 0.2f * u;
+    c->y    = H - botIn - 0.2f * u;
+    c->hitR = 0;
+
+    c       = &tCtrl[TCTRL_FLIPR];
+    c->r    = 0.14f * u;
+    c->x    = W - sideIn - 0.2f * u;
+    c->y    = H - botIn - 0.2f * u;
+    c->hitR = 0;
+}
+
+bool HitCircle(int32 id, float px, float py)
+{
+    TouchControl *c = &tCtrl[id];
+    if (!c->visible)
+        return false;
+    float dx = px - c->x, dy = py - c->y;
+    return dx * dx + dy * dy <= c->hitR * c->hitR;
+}
+
+int32 TouchHitTest(float px, float py)
+{
+    // small buttons first
+    if (HitCircle(TCTRL_SKIP, px, py))
+        return TCTRL_SKIP;
+    if (HitCircle(TCTRL_PAUSE, px, py))
+        return TCTRL_PAUSE;
+    if (HitCircle(TCTRL_ACTION, px, py))
+        return TCTRL_ACTION;
+
+    bool leftHalf = px < tScrW * 0.5f;
+    switch (tMode) {
+        case MTOUCH_MODE_PLATFORM:
+        case MTOUCH_MODE_SPECIAL:
+        case MTOUCH_MODE_PUYO:
+            if (leftHalf) {
+                // the d-pad answers in the lower-left area (generous, but it never moves)
+                if (HitCircle(TCTRL_DPAD, px, py) || (px < tScrW * 0.4f && py > tScrH * 0.3f))
+                    return TCTRL_DPAD;
+                return TCTRL_NONE;
+            }
+            return TCTRL_JUMP;
+
+        case MTOUCH_MODE_PINBALL: return leftHalf ? TCTRL_FLIPL : TCTRL_FLIPR;
+
+        default: break;
+    }
+    return TCTRL_NONE; // pass through to the game (menus)
+}
+
+void HapticForControl(int32 ctrl)
+{
+#if RETRO_PLATFORM == RETRO_iOS
+    switch (ctrl) {
+        case TCTRL_ACTION: iosHapticTap(2); break;
+        case TCTRL_PAUSE:
+        case TCTRL_SKIP: iosHapticTap(0); break;
+        default: break; // no buzzing on jump / d-pad
+    }
+#endif
+}
+
+void StartDpad(float px, float py)
+{
+    // the cross never moves
+    (void)px;
+    (void)py;
+    tDpadX        = tDpadRestX;
+    tDpadY        = tDpadRestY;
+    tDpadAnchored = true;
+}
+
+void UpdateDpad(float px, float py)
+{
+    float r  = tCtrl[TCTRL_DPAD].r;
+    float dx = px - tDpadX, dy = py - tDpadY;
+    float d  = sqrtf(dx * dx + dy * dy);
+
+    tDpadDir = 0;
+    if (d < r * 0.2f)
+        return;
+
+    // 8-way, diagonals get a 45 degree slice (y grows downwards)
+    float a = atan2f(dy, dx) * (180.0f / (float)M_PI);
+    if (a > -67.5f && a < 67.5f)
+        tDpadDir |= 8;
+    if (a > 112.5f || a < -112.5f)
+        tDpadDir |= 4;
+    if (a > 22.5f && a < 157.5f)
+        tDpadDir |= 2;
+    if (a < -22.5f && a > -157.5f)
+        tDpadDir |= 1;
+}
+
+void SetPadMode(bool padMode, RSDK::InputDevice *pad)
+{
+    using namespace RSDK;
+    if (tPadMode == padMode)
+        return;
+    tPadMode = padMode;
+
+    InputDevice *target = padMode ? pad : (InputDevice *)tDevice;
+    if (target && inputSlots[0] != (int32)target->id) {
+        InputDevice *prev = inputSlotDevices[0];
+        if (prev)
+            prev->isAssigned = false;
+        AssignInputSlotToDevice(CONT_P1, target->id);
+    }
+}
+
+// =====================
+// Drawing
+// =====================
+
+SDL_Vertex tVerts[TOUCH_MAX_VERTS];
+int32 tVertCount = 0;
+
+inline SDL_Color Col(uint32 rgb, float a)
+{
+    SDL_Color c;
+    c.r = (rgb >> 16) & 0xFF;
+    c.g = (rgb >> 8) & 0xFF;
+    c.b = rgb & 0xFF;
+    c.a = (uint8)(Clamp01(a) * 255.0f);
+    return c;
+}
+
+inline void Vert(float x, float y, SDL_Color c)
+{
+    if (tVertCount >= TOUCH_MAX_VERTS)
+        return;
+    SDL_Vertex *v  = &tVerts[tVertCount++];
+    v->position.x  = x;
+    v->position.y  = y;
+    v->color       = c;
+    v->tex_coord.x = 0;
+    v->tex_coord.y = 0;
+}
+
+inline void Tri(float x0, float y0, SDL_Color c0, float x1, float y1, SDL_Color c1, float x2, float y2, SDL_Color c2)
+{
+    if (tVertCount + 3 > TOUCH_MAX_VERTS)
+        return;
+    Vert(x0, y0, c0);
+    Vert(x1, y1, c1);
+    Vert(x2, y2, c2);
+}
+
+inline SDL_Color Clear(SDL_Color c)
+{
+    c.a = 0;
+    return c;
+}
+
+int32 Segments(float r)
+{
+    int32 s = (int32)(r * 0.5f);
+    return s < 24 ? 24 : (s > 96 ? 96 : s);
+}
+
+// filled disc with a soft 1.5px edge
+void Disc(float cx, float cy, float r, SDL_Color c)
+{
+    if (c.a == 0 || r <= 0)
+        return;
+    const float f = 1.5f;
+    int32 seg     = Segments(r);
+    float ri = fmaxf(r - f, 0), ro = r;
+    SDL_Color e = Clear(c);
+    for (int32 i = 0; i < seg; ++i) {
+        float a0 = (float)i / seg * 2 * (float)M_PI, a1 = (float)(i + 1) / seg * 2 * (float)M_PI;
+        float c0 = cosf(a0), s0 = sinf(a0), c1 = cosf(a1), s1 = sinf(a1);
+        Tri(cx, cy, c, cx + c0 * ri, cy + s0 * ri, c, cx + c1 * ri, cy + s1 * ri, c);
+        Tri(cx + c0 * ri, cy + s0 * ri, c, cx + c0 * ro, cy + s0 * ro, e, cx + c1 * ri, cy + s1 * ri, c);
+        Tri(cx + c1 * ri, cy + s1 * ri, c, cx + c0 * ro, cy + s0 * ro, e, cx + c1 * ro, cy + s1 * ro, e);
+    }
+}
+
+// stroked arc from a0 to a1 (radians), soft edges
+void Arc(float cx, float cy, float r, float thick, float a0, float a1, SDL_Color c)
+{
+    if (c.a == 0)
+        return;
+    const float f = 1.2f;
+    float span    = fabsf(a1 - a0);
+    int32 seg     = (int32)(Segments(r) * span / (2 * (float)M_PI)) + 2;
+    float r0 = r - thick * 0.5f - f, r1 = r - thick * 0.5f, r2 = r + thick * 0.5f, r3 = r + thick * 0.5f + f;
+    SDL_Color e = Clear(c);
+    for (int32 i = 0; i < seg; ++i) {
+        float t0 = a0 + (a1 - a0) * i / seg, t1 = a0 + (a1 - a0) * (i + 1) / seg;
+        float c0 = cosf(t0), s0 = sinf(t0), c1 = cosf(t1), s1 = sinf(t1);
+        float rs[4]      = { r0, r1, r2, r3 };
+        SDL_Color cs[4]  = { e, c, c, e };
+        for (int32 b = 0; b < 3; ++b) {
+            Tri(cx + c0 * rs[b], cy + s0 * rs[b], cs[b], cx + c0 * rs[b + 1], cy + s0 * rs[b + 1], cs[b + 1], cx + c1 * rs[b], cy + s1 * rs[b],
+                cs[b]);
+            Tri(cx + c1 * rs[b], cy + s1 * rs[b], cs[b], cx + c0 * rs[b + 1], cy + s0 * rs[b + 1], cs[b + 1], cx + c1 * rs[b + 1],
+                cy + s1 * rs[b + 1], cs[b + 1]);
+        }
+    }
+}
+
+inline void Ring(float cx, float cy, float r, float thick, SDL_Color c) { Arc(cx, cy, r, thick, 0, 2 * (float)M_PI, c); }
+
+// thick line with round caps
+void Line(float x0, float y0, float x1, float y1, float thick, SDL_Color c)
+{
+    float dx = x1 - x0, dy = y1 - y0;
+    float l = sqrtf(dx * dx + dy * dy);
+    if (l < 0.001f)
+        return;
+    float nx = -dy / l * thick * 0.5f, ny = dx / l * thick * 0.5f;
+    Tri(x0 + nx, y0 + ny, c, x1 + nx, y1 + ny, c, x0 - nx, y0 - ny, c);
+    Tri(x0 - nx, y0 - ny, c, x1 + nx, y1 + ny, c, x1 - nx, y1 - ny, c);
+    Disc(x0, y0, thick * 0.5f, c);
+    Disc(x1, y1, thick * 0.5f, c);
+}
+
+// convex / star-shaped polygon, fanned from its centre
+void Fan(float cx, float cy, const float *pts, int32 count, SDL_Color c)
+{
+    for (int32 i = 0; i < count; ++i) {
+        int32 j = (i + 1) % count;
+        Tri(cx, cy, c, pts[i * 2], pts[i * 2 + 1], c, pts[j * 2], pts[j * 2 + 1], c);
+    }
+}
+
+void Triangle(float cx, float cy, float size, float angle, SDL_Color c)
+{
+    float pts[6];
+    for (int32 i = 0; i < 3; ++i) {
+        float a        = angle + i * 2.0f * (float)M_PI / 3.0f;
+        pts[i * 2]     = cx + cosf(a) * size;
+        pts[i * 2 + 1] = cy + sinf(a) * size;
+    }
+    Fan(cx, cy, pts, 3, c);
+}
+
+void Star(float cx, float cy, float ro, float ri, SDL_Color c)
+{
+    float pts[20];
+    for (int32 i = 0; i < 10; ++i) {
+        float a        = -(float)M_PI / 2 + i * (float)M_PI / 5;
+        float r        = (i & 1) ? ri : ro;
+        pts[i * 2]     = cx + cosf(a) * r;
+        pts[i * 2 + 1] = cy + sinf(a) * r;
+    }
+    Fan(cx, cy, pts, 10, c);
+}
+
+// circular arrow: arc + arrow head at the end
+void ArcArrow(float cx, float cy, float r, float thick, float a0, float a1, SDL_Color c)
+{
+    Arc(cx, cy, r, thick, a0, a1, c);
+    float dir = a1 > a0 ? 1.0f : -1.0f;
+    float hx = cx + cosf(a1) * r, hy = cy + sinf(a1) * r;
+    // tangent direction at the end of the arc
+    float tx = -sinf(a1) * dir, ty = cosf(a1) * dir;
+    float hs = thick * 1.6f;
+    float pts[6] = {
+        hx + tx * hs * 1.1f, hy + ty * hs * 1.1f, hx - ty * hs * 0.9f - tx * hs * 0.2f, hy + tx * hs * 0.9f - ty * hs * 0.2f,
+        hx + ty * hs * 0.9f - tx * hs * 0.2f, hy - tx * hs * 0.9f - ty * hs * 0.2f,
+    };
+    Fan((pts[0] + pts[2] + pts[4]) / 3, (pts[1] + pts[3] + pts[5]) / 3, pts, 3, c);
+}
+
+const uint32 COL_FILL  = 0x101010;
+const uint32 COL_EDGE  = 0x2A2A2A;
+const uint32 COL_SOFT  = 0xBDBDBD;
+const uint32 COL_WHITE = 0xFFFFFF;
+const uint32 COL_GOLD  = 0xFFC93C;
+const uint32 COL_CYAN  = 0x4FD8FF;
+
+void DrawButtonBase(TouchControl *c, float a, float scale, uint32 accent, bool accented)
+{
+    // dark translucent disc with a thick dark rim and a faint inner ring
+    float r = c->r * scale;
+    Disc(c->x, c->y, r, Col(COL_FILL, (0.32f + 0.18f * c->press) * a));
+    if (c->press > 0)
+        Disc(c->x, c->y, r, Col(accented ? accent : 0x6A6A6A, 0.3f * c->press * a));
+    Ring(c->x, c->y, r - r * 0.05f, fmaxf(r * 0.1f, 3.0f), Col(accented ? accent : COL_EDGE, (accented ? 0.9f : 0.85f) * a));
+    Ring(c->x, c->y, r * 0.78f, fmaxf(r * 0.025f, 1.5f), Col(COL_SOFT, 0.12f * a));
+}
+
+void DrawIcon(int32 icon, float cx, float cy, float r, SDL_Color c, SDL_Color accent)
+{
+    switch (icon) {
+        case TICON_JUMP: {
+            float t = r * 0.13f;
+            Line(cx - r * 0.34f, cy + r * 0.14f, cx, cy - r * 0.2f, t, c);
+            Line(cx, cy - r * 0.2f, cx + r * 0.34f, cy + r * 0.14f, t, c);
+            break;
+        }
+
+        case TICON_SUPER: Star(cx, cy + r * 0.03f, r * 0.52f, r * 0.22f, accent); break;
+
+        case TICON_SWAP: {
+            float t = r * 0.11f;
+            ArcArrow(cx, cy, r * 0.42f, t, (float)M_PI * 1.08f, (float)M_PI * 1.85f, accent);
+            ArcArrow(cx, cy, r * 0.42f, t, (float)M_PI * 0.08f, (float)M_PI * 0.85f, accent);
+            break;
+        }
+
+        case TICON_ROTATE_CW: ArcArrow(cx, cy, r * 0.4f, r * 0.11f, (float)M_PI * 0.75f, (float)M_PI * 2.35f, c); break;
+        case TICON_ROTATE_CCW: ArcArrow(cx, cy, r * 0.4f, r * 0.11f, (float)M_PI * 0.25f, -(float)M_PI * 1.35f, c); break;
+
+        default: break;
+    }
+}
+
+void Rect(float x0, float y0, float x1, float y1, SDL_Color c)
+{
+    Tri(x0, y0, c, x1, y0, c, x0, y1, c);
+    Tri(x0, y1, c, x1, y0, c, x1, y1, c);
+}
+
+void DrawDpad(float a)
+{
+    TouchControl *c = &tCtrl[TCTRL_DPAD];
+    float R         = c->r;      // centre -> end of an arm
+    float w         = R * 0.34f; // half width of an arm
+    float x = tDpadX, y = tDpadY;
+
+    // body (3 rects so the translucent fill never overlaps itself)
+    SDL_Color fill = Col(COL_FILL, 0.34f * a);
+    Rect(x - R, y - w, x + R, y + w, fill);
+    Rect(x - w, y - R, x + w, y - w, fill);
+    Rect(x - w, y + w, x + w, y + R, fill);
+
+    // pressed arms
+    SDL_Color lit = Col(0x6A6A6A, 0.45f * a);
+    if (tDpadDir & 1)
+        Rect(x - w, y - R, x + w, y - w, lit);
+    if (tDpadDir & 2)
+        Rect(x - w, y + w, x + w, y + R, lit);
+    if (tDpadDir & 4)
+        Rect(x - R, y - w, x - w, y + w, lit);
+    if (tDpadDir & 8)
+        Rect(x + w, y - w, x + R, y + w, lit);
+
+    // thick dark rim, same as the round buttons
+    float pts[12][2] = {
+        { x - w, y - R }, { x + w, y - R }, { x + w, y - w }, { x + R, y - w }, { x + R, y + w }, { x + w, y + w },
+        { x + w, y + R }, { x - w, y + R }, { x - w, y + w }, { x - R, y + w }, { x - R, y - w }, { x - w, y - w },
+    };
+    float t        = fmaxf(R * 0.075f, 3.0f);
+    SDL_Color edge = Col(COL_EDGE, 0.85f * a);
+    for (int32 i = 0; i < 12; ++i) {
+        int32 n = (i + 1) % 12;
+        Line(pts[i][0], pts[i][1], pts[n][0], pts[n][1], t, edge);
+    }
+
+    // small arrows
+    const uint8 bits[4] = { 1, 8, 2, 4 };
+    const float angs[4] = { -(float)M_PI / 2, 0, (float)M_PI / 2, (float)M_PI };
+    for (int32 i = 0; i < 4; ++i) {
+        bool on  = (tDpadDir & bits[i]) != 0;
+        float ax = x + cosf(angs[i]) * R * 0.66f;
+        float ay = y + sinf(angs[i]) * R * 0.66f;
+        Triangle(ax, ay, w * 0.36f, angs[i], Col(COL_SOFT, (on ? 0.8f : 0.3f) * a));
+    }
+
+    Disc(x, y, w * 0.42f, Col(COL_EDGE, 0.5f * a));
+}
+
+} // namespace
+
+// =====================
+// Device
+// =====================
+
+void RSDK::SKU::InputDeviceTouch::UpdateInput()
+{
+    ++mobileTouchHints.frame;
+    ++tTime;
+
+    TouchLayout();
+
+    // ---- what is going on in the game ----
+    bool menuOpen = HintActive(mobileTouchHints.menuFrame, 2);
+    tPlaying      = !menuOpen && HintActive(mobileTouchHints.playFrame, 20);
+    tMode         = tPlaying ? mobileTouchHints.mode : MTOUCH_MODE_NONE;
+    bool canSuper = tPlaying && tMode == MTOUCH_MODE_PLATFORM && HintActive(mobileTouchHints.superFrame, 20);
+    bool swapReady = tPlaying && tMode == MTOUCH_MODE_PLATFORM && HintActive(mobileTouchHints.swapFrame, 2);
+    bool canSwap   = tPlaying && tMode == MTOUCH_MODE_PLATFORM && HintActive(mobileTouchHints.swapAvailFrame, 20);
+    bool canSkip  = !menuOpen && HintActive(mobileTouchHints.skipFrame, 3);
+
+    tNotPlayTimer = tPlaying ? 0 : tNotPlayTimer + 1;
+
+    bool stickMode = tMode == MTOUCH_MODE_PLATFORM || tMode == MTOUCH_MODE_SPECIAL || tMode == MTOUCH_MODE_PUYO;
+
+    tCtrl[TCTRL_DPAD].visible  = stickMode;
+    tCtrl[TCTRL_JUMP].visible  = stickMode;
+    tCtrl[TCTRL_FLIPL].visible = tMode == MTOUCH_MODE_PINBALL;
+    tCtrl[TCTRL_FLIPR].visible = tMode == MTOUCH_MODE_PINBALL;
+    tCtrl[TCTRL_SKIP].visible  = canSkip;
+    tCtrl[TCTRL_PAUSE].visible = tPlaying && !canSkip;
+    tCtrl[TCTRL_BACK].visible  = false; // menus are fully touch-driven by the game itself
+
+    tCtrl[TCTRL_JUMP].icon = tMode == MTOUCH_MODE_PUYO ? TICON_ROTATE_CW : TICON_JUMP;
+
+    TouchControl *act = &tCtrl[TCTRL_ACTION];
+    act->visible      = (tMode == MTOUCH_MODE_PUYO) || canSuper || canSwap;
+    tActionReady      = tMode == MTOUCH_MODE_PUYO || canSuper || swapReady;
+    if (act->visible) {
+        int32 icon = tMode == MTOUCH_MODE_PUYO ? TICON_ROTATE_CCW : (canSuper ? TICON_SUPER : TICON_SWAP);
+        if (icon != act->icon || act->alpha < 0.05f)
+            act->flash = 1.0f;
+        act->icon = icon; // keep the last icon while fading out
+    }
+
+    // ---- gamepad / keyboard takes over? (only while no finger is on the screen, so stick drift can't hide the overlay mid-play) ----
+    for (int32 i = 0; i < inputDeviceCount && tFingerCount == 0 && tIdleTimer > 30; ++i) {
+        InputDevice *dev = inputDeviceList[i];
+        if (!dev || dev == this || !dev->active || dev->disabled)
+            continue;
+#if RETRO_INPUTDEVICE_SDL2
+        if ((dev->gamepadType >> 16) == DEVICE_API_SDL2) {
+            InputDeviceSDL *pad = (InputDeviceSDL *)dev;
+            if (pad->buttonMasks & ~pad->prevButtonMasks) { // a real button was pressed (sticks/drift don't count)
+                SetPadMode(true, dev);
+                break;
+            }
+        }
+#endif
+    }
+
+    // ---- fingers ----
+    for (int32 f = 0; f < tFingerCount; ++f) tFinger[f].alive = false;
+
+    bool newPress = false;
+    int32 devices = SDL_GetNumTouchDevices();
+    for (int32 d = 0; d < devices; ++d) {
+        SDL_TouchID touchID = SDL_GetTouchDevice(d);
+        int32 fingers       = SDL_GetNumTouchFingers(touchID);
+        for (int32 i = 0; i < fingers; ++i) {
+            SDL_Finger *finger = SDL_GetTouchFinger(touchID, i);
+            if (!finger)
+                continue;
+
+            TouchFinger *tf = nullptr;
+            for (int32 f = 0; f < tFingerCount; ++f) {
+                if (tFinger[f].id == finger->id) {
+                    tf = &tFinger[f];
+                    break;
+                }
+            }
+
+            if (!tf) {
+                if (tFingerCount >= TOUCH_MAX_FINGERS)
+                    continue;
+
+                if (tPadMode)
+                    SetPadMode(false, nullptr);
+
+                tf     = &tFinger[tFingerCount++];
+                tf->id = finger->id;
+                float px = finger->x * tScrW, py = finger->y * tScrH;
+                tf->ctrl = TouchHitTest(px, py);
+                newPress = true;
+
+                if (tf->ctrl == TCTRL_DPAD)
+                    StartDpad(px, py);
+                HapticForControl(tf->ctrl);
+            }
+
+            tf->nx    = finger->x;
+            tf->ny    = finger->y;
+            tf->alive = true;
+        }
+    }
+
+    // drop lifted fingers
+    for (int32 f = 0; f < tFingerCount;) {
+        if (!tFinger[f].alive) {
+            tFinger[f] = tFinger[--tFingerCount];
+        }
+        else {
+            ++f;
+        }
+    }
+
+    // ---- controls -> buttons ----
+    for (int32 i = 0; i < TCTRL_COUNT; ++i) tCtrl[i].held = false;
+
+    TouchFinger *dpadFinger = nullptr;
+    touchInfo.count         = 0;
+    for (int32 f = 0; f < tFingerCount; ++f) {
+        TouchFinger *tf = &tFinger[f];
+        if (tf->ctrl == TCTRL_NONE) {
+            if (touchInfo.count < 0x10) {
+                touchInfo.x[touchInfo.count]    = tf->nx;
+                touchInfo.y[touchInfo.count]    = tf->ny;
+                touchInfo.down[touchInfo.count] = true;
+                touchInfo.count++;
+            }
+        }
+        else {
+            tCtrl[tf->ctrl].held = true;
+            if (tf->ctrl == TCTRL_DPAD && !dpadFinger)
+                dpadFinger = tf;
+        }
+    }
+    for (int32 i = touchInfo.count; i < 0x10; ++i) touchInfo.down[i] = false;
+
+    if (dpadFinger) {
+        UpdateDpad(dpadFinger->nx * tScrW, dpadFinger->ny * tScrH);
+    }
+    else {
+        tDpadDir      = 0;
+        tDpadAnchored = false;
+        tDpadX        = tDpadRestX;
+        tDpadY        = tDpadRestY;
+    }
+
+    bool jump   = tCtrl[TCTRL_JUMP].held;
+    bool action = tCtrl[TCTRL_ACTION].held;
+
+    stateUp    = (tDpadDir & 1) != 0;
+    stateDown  = (tDpadDir & 2) != 0;
+    stateLeft  = (tDpadDir & 4) != 0;
+    stateRight = (tDpadDir & 8) != 0;
+    stateA     = jump;
+    stateB     = tCtrl[TCTRL_BACK].held || tCtrl[TCTRL_FLIPR].held || (action && tMode == MTOUCH_MODE_PUYO);
+    stateX     = tCtrl[TCTRL_FLIPL].held;
+    stateY     = action && tMode != MTOUCH_MODE_PUYO;
+    stateStart = tCtrl[TCTRL_PAUSE].held || tCtrl[TCTRL_SKIP].held;
+
+    if (tPadMode) {
+        stateUp = stateDown = stateLeft = stateRight = stateA = stateB = stateX = stateY = stateStart = false;
+    }
+
+    // ---- device bookkeeping ----
+    if (newPress) {
+        inactiveTimer[0] = 0;
+        anyPress         = true;
+        if (stateA || stateStart)
+            inactiveTimer[1] = 0;
+        else
+            ++inactiveTimer[1];
+
+        if (!tPadMode && inputSlots[0] != (int32)id) {
+            if (inputSlotDevices[0] && inputSlotDevices[0] != this)
+                inputSlotDevices[0]->isAssigned = false;
+            AssignInputSlotToDevice(CONT_P1, id);
+        }
+    }
+    else {
+        ++inactiveTimer[0];
+        ++inactiveTimer[1];
+        anyPress = false;
+    }
+
+    // the touch screen is player 1 only: never let it drive the sidekick
+    for (int32 p = 1; p < PLAYER_COUNT; ++p) {
+        if (inputSlots[p] == (int32)id) {
+            inputSlots[p]       = INPUT_AUTOASSIGN;
+            inputSlotDevices[p] = nullptr;
+        }
+    }
+    if (!tPadMode && inputSlots[0] == (int32)id)
+        isAssigned = true;
+
+    // ---- animation ----
+    tIdleTimer = tFingerCount ? 0 : tIdleTimer + 1;
+    tActivity  = Approach(tActivity, tIdleTimer > 240 ? 0.65f : 1.0f, tIdleTimer > 240 ? 0.01f : 0.12f);
+    tPadFade   = Approach(tPadFade, tPadMode ? 0.0f : 1.0f, 0.08f);
+
+    for (int32 i = 0; i < TCTRL_COUNT; ++i) {
+        TouchControl *c = &tCtrl[i];
+        float fadeIn    = i == TCTRL_ACTION ? 0.25f : 0.09f;
+        c->alpha        = Approach(c->alpha, c->visible ? 1.0f : 0.0f, c->visible ? fadeIn : 0.15f);
+        c->press        = Approach(c->press, c->held ? 1.0f : 0.0f, 0.35f);
+        c->flash        = Approach(c->flash, 0.0f, 0.025f);
+    }
+
+    tActionDim = Approach(tActionDim, tActionReady ? 1.0f : 0.45f, 0.15f);
+
+    ProcessInput(CONT_ANY);
+}
+
+void RSDK::SKU::InputDeviceTouch::ProcessInput(int32 controllerID)
+{
+    controller[controllerID].keyUp.press |= stateUp;
+    controller[controllerID].keyDown.press |= stateDown;
+    controller[controllerID].keyLeft.press |= stateLeft;
+    controller[controllerID].keyRight.press |= stateRight;
+    controller[controllerID].keyA.press |= stateA;
+    controller[controllerID].keyB.press |= stateB;
+    controller[controllerID].keyX.press |= stateX;
+    controller[controllerID].keyY.press |= stateY;
+    controller[controllerID].keyStart.press |= stateStart;
+}
+
+void RSDK::SKU::InputDeviceTouch::CloseDevice()
+{
+    active     = false;
+    isAssigned = false;
+}
+
+void RSDK::SKU::InitTouchInputAPI()
+{
+    memset(&mobileTouchHints, 0, sizeof(mobileTouchHints));
+    mobileTouchHints.frame = 1000; // so that zeroed marks count as "long ago"
+
+    memset(tCtrl, 0, sizeof(tCtrl));
+    tFingerCount = 0;
+
+#if RETRO_PLATFORM == RETRO_iOS
+    SDL_SetHint(SDL_HINT_TOUCH_MOUSE_EVENTS, "0");
+#endif
+
+    if (inputDeviceCount >= INPUTDEVICE_COUNT)
+        return;
+
+    if (inputDeviceList[inputDeviceCount])
+        delete inputDeviceList[inputDeviceCount];
+
+    tDevice                           = new InputDeviceTouch();
+    inputDeviceList[inputDeviceCount] = tDevice;
+
+    tDevice->gamepadType = (DEVICE_API_NONE << 16) | (DEVICE_TYPE_CONTROLLER << 8) | (DEVICE_XBOX << 0);
+    tDevice->id          = 0x70C4AD01;
+    tDevice->active      = true;
+    tDevice->disabled    = false;
+    tDevice->isAssigned  = false;
+    tDevice->anyPress    = false;
+    tDevice->inactiveTimer[0] = 0;
+    tDevice->inactiveTimer[1] = 0;
+
+    tDevice->stateUp = tDevice->stateDown = tDevice->stateLeft = tDevice->stateRight = 0;
+    tDevice->stateA = tDevice->stateB = tDevice->stateX = tDevice->stateY = tDevice->stateStart = 0;
+
+    inputDeviceCount++;
+
+    TouchLayout();
+    tDpadX = tDpadRestX;
+    tDpadY = tDpadRestY;
+}
+
+#if RETRO_RENDERDEVICE_SDL2
+void RSDK::SKU::DrawTouchOverlay(SDL_Renderer *renderer)
+{
+    if (!tDevice)
+        return;
+
+    int32 ow = 0, oh = 0;
+    SDL_GetRendererOutputSize(renderer, &ow, &oh);
+    if (ow <= 0 || oh <= 0)
+        return;
+    tScrW = (float)ow;
+    tScrH = (float)oh;
+
+    float global = tPadFade;
+    if (global < 0.01f)
+        return;
+
+    tVertCount = 0;
+
+    // ---- d-pad ----
+    TouchControl *dp = &tCtrl[TCTRL_DPAD];
+    if (dp->alpha > 0.01f)
+        DrawDpad(dp->alpha * tActivity * global);
+
+    // ---- jump ----
+    TouchControl *jp = &tCtrl[TCTRL_JUMP];
+    if (jp->alpha > 0.01f) {
+        float a     = jp->alpha * tActivity * global;
+        float scale = 1.0f - 0.07f * jp->press;
+        DrawButtonBase(jp, a, scale, COL_WHITE, false);
+        if (jp->icon != TICON_JUMP)
+            DrawIcon(jp->icon, jp->x, jp->y, jp->r * scale, Col(COL_SOFT, 0.6f * a), Col(COL_SOFT, 0.6f * a));
+    }
+
+    // ---- contextual action ----
+    TouchControl *ac = &tCtrl[TCTRL_ACTION];
+    if (ac->alpha > 0.01f) {
+        float a       = ac->alpha * global * tActionDim;
+        float scale   = 1.0f - 0.08f * ac->press;
+        bool special  = ac->icon == TICON_SUPER || ac->icon == TICON_SWAP;
+        uint32 accent = ac->icon == TICON_SUPER ? COL_GOLD : (ac->icon == TICON_SWAP ? COL_CYAN : COL_WHITE);
+
+        DrawButtonBase(ac, a, scale, accent, special);
+        DrawIcon(ac->icon, ac->x, ac->y, ac->r * scale, Col(COL_WHITE, 0.92f * a), Col(special ? accent : COL_WHITE, 0.95f * a));
+    }
+
+    // ---- pinball flippers ----
+    for (int32 i = TCTRL_FLIPL; i <= TCTRL_FLIPR; ++i) {
+        TouchControl *fc = &tCtrl[i];
+        if (fc->alpha <= 0.01f)
+            continue;
+        float a     = fc->alpha * tActivity * global;
+        float scale = 1.0f - 0.07f * fc->press;
+        DrawButtonBase(fc, a, scale, COL_WHITE, false);
+
+        float dir = i == TCTRL_FLIPL ? 1.0f : -1.0f;
+        float r   = fc->r * scale;
+        float lift = fc->press * 0.35f;
+        float px = fc->x - dir * r * 0.38f, py = fc->y + r * 0.05f;
+        float ex = fc->x + dir * r * 0.4f, ey = fc->y + r * (0.18f - lift);
+        Line(px, py, ex, ey, r * 0.16f, Col(COL_WHITE, 0.9f * a));
+        Disc(px, py, r * 0.13f, Col(COL_WHITE, 0.9f * a));
+    }
+
+    // ---- pause ----
+    TouchControl *pc = &tCtrl[TCTRL_PAUSE];
+    if (pc->alpha > 0.01f) {
+        float a     = pc->alpha * global;
+        float scale = 1.0f - 0.08f * pc->press;
+        float r     = pc->r * scale;
+        Disc(pc->x, pc->y, r, Col(0x000000, (0.82f + 0.1f * pc->press) * a));
+        Rect(pc->x - r * 0.34f, pc->y - r * 0.38f, pc->x - r * 0.1f, pc->y + r * 0.38f, Col(COL_WHITE, 0.95f * a));
+        Rect(pc->x + r * 0.1f, pc->y - r * 0.38f, pc->x + r * 0.34f, pc->y + r * 0.38f, Col(COL_WHITE, 0.95f * a));
+    }
+
+    // ---- skip ----
+    TouchControl *sk = &tCtrl[TCTRL_SKIP];
+    if (sk->alpha > 0.01f) {
+        float a     = sk->alpha * global;
+        float scale = EaseOutBack(sk->alpha) * (1.0f - 0.08f * sk->press);
+        float r     = sk->r * scale;
+        Disc(sk->x, sk->y, r, Col(0x000000, (0.82f + 0.1f * sk->press) * a));
+        SDL_Color ic = Col(COL_WHITE, 0.95f * a);
+        Triangle(sk->x - r * 0.2f, sk->y, r * 0.24f, 0, ic);
+        Triangle(sk->x + r * 0.1f, sk->y, r * 0.24f, 0, ic);
+        Rect(sk->x + r * 0.32f, sk->y - r * 0.22f, sk->x + r * 0.42f, sk->y + r * 0.22f, ic);
+    }
+
+    // ---- back ----
+    TouchControl *bk = &tCtrl[TCTRL_BACK];
+    if (bk->alpha > 0.01f) {
+        float a     = bk->alpha * global * 0.85f;
+        float scale = 1.0f - 0.08f * bk->press;
+        DrawButtonBase(bk, a, scale, COL_WHITE, false);
+        float r      = bk->r * scale;
+        SDL_Color ic = Col(COL_WHITE, 0.92f * a);
+        Line(bk->x + r * 0.1f, bk->y - r * 0.3f, bk->x - r * 0.2f, bk->y, r * 0.15f, ic);
+        Line(bk->x - r * 0.2f, bk->y, bk->x + r * 0.1f, bk->y + r * 0.3f, r * 0.15f, ic);
+    }
+
+    if (!tVertCount)
+        return;
+
+    // draw in real output pixels on top of the (letterboxed) game frame
+    int32 lw = 0, lh = 0;
+    SDL_RenderGetLogicalSize(renderer, &lw, &lh);
+    SDL_RenderSetLogicalSize(renderer, 0, 0);
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+
+    SDL_RenderGeometry(renderer, NULL, tVerts, tVertCount, NULL, 0);
+
+    if (lw && lh)
+        SDL_RenderSetLogicalSize(renderer, lw, lh);
+}
+#endif
diff --git a/RSDKv5/RSDK/Input/Touch/TouchInputDevice.hpp b/RSDKv5/RSDK/Input/Touch/TouchInputDevice.hpp
new file mode 100644
index 0000000..f7e2fcd
--- /dev/null
+++ b/RSDKv5/RSDK/Input/Touch/TouchInputDevice.hpp
@@ -0,0 +1,31 @@
+// On-screen touch controls for touch-only devices (iOS build).
+// The device reads raw fingers from SDL, turns touches on the controls into controller buttons,
+// forwards all other touches to the game (menus use TouchInfo), and draws the overlay on top of the frame.
+
+namespace SKU
+{
+
+struct InputDeviceTouch : InputDevice {
+    void UpdateInput();
+    void ProcessInput(int32 controllerID);
+    void CloseDevice();
+
+    uint8 stateUp;
+    uint8 stateDown;
+    uint8 stateLeft;
+    uint8 stateRight;
+    uint8 stateA;
+    uint8 stateB;
+    uint8 stateX;
+    uint8 stateY;
+    uint8 stateStart;
+};
+
+void InitTouchInputAPI();
+
+#if RETRO_RENDERDEVICE_SDL2
+// called right before the frame is presented
+void DrawTouchOverlay(SDL_Renderer *renderer);
+#endif
+
+} // namespace SKU
