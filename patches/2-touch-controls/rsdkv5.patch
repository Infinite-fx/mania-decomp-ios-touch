 #endif
 #include "cocoaHelpers.hpp"
 
@@ -34,6 +35,23 @@ const char* getBundleResourcesPath(void)
         return bundlePath;
     }
 }
+
+void iosHapticTap(int strength)
+{
+    static UISelectionFeedbackGenerator *selection = nil;
+    static UIImpactFeedbackGenerator *light        = nil;
+    static UIImpactFeedbackGenerator *medium       = nil;
+    if (!selection) {
+        selection = [[UISelectionFeedbackGenerator alloc] init];
+        light     = [[UIImpactFeedbackGenerator alloc] initWithStyle:UIImpactFeedbackStyleLight];
+        medium    = [[UIImpactFeedbackGenerator alloc] initWithStyle:UIImpactFeedbackStyleMedium];
+    }
+    switch (strength) {
+        case 0: [selection selectionChanged]; break;
+        case 1: [light impactOccurred]; break;
+        default: [medium impactOccurred]; break;
+    }
+}
 #endif
 
 #endif
