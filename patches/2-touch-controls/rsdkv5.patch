 #if TARGET_OS_IPHONE
 // read-only folder inside the .app bundle (Data.rsdk can be shipped there)
 const char* getBundleResourcesPath(void);
+// light haptic feedback: 0 = selection, 1 = light, 2 = medium
+void iosHapticTap(int strength);
 #endif
 #endif
 
