diff --git a/SonicMania/Objects/Global/Player.c b/SonicMania/Objects/Global/Player.c
index d158186..eecf9a1 100644
--- a/SonicMania/Objects/Global/Player.c
+++ b/SonicMania/Objects/Global/Player.c
@@ -6387,6 +6387,40 @@ void Player_SfxUpdate_RaySwoop(int32 sfxID)
 }
 #endif
 
+#if MANIA_MOBILE_TOUCH
+// on-screen controls: report what the player can do right now so the engine can show the matching buttons
+static void Player_MobileTouch_Report(EntityPlayer *self)
+{
+    if (self->controllerID != CONT_P1)
+        return;
+
+    mobileTouchHints.mode = MTOUCH_MODE_PLATFORM;
+    MOBILETOUCH_MARK(playFrame);
+
+    bool32 timeOK = SceneInfo->timeEnabled || ERZStart;
+    if (timeOK && self->jumpAbilityState == 1 && self->superState < SUPERSTATE_SUPER && self->rings >= 50
+        && SaveGame_GetSaveRAM()->collectedEmeralds == 0b01111111) {
+#if MANIA_USE_PLUS
+        if (!Player->canSuperCB || Player->canSuperCB(true))
+#endif
+            MOBILETOUCH_MARK(superFrame);
+    }
+
+#if MANIA_USE_PLUS
+    if (globals->gameMode == MODE_ENCORE && !Player->cantSwap && RSDK_GET_ENTITY(SLOT_PLAYER2, Player)->classID == Player->classID)
+        MOBILETOUCH_MARK(swapAvailFrame);
+
+    if (globals->gameMode == MODE_ENCORE && !HUD->swapCooldown && !Player->cantSwap && !Player->respawnTimer && SceneInfo->timeEnabled
+        && self->drawGroup != 2 && Player_CheckValidState(self)) {
+        EntityPlayer *sidekick = RSDK_GET_ENTITY(SLOT_PLAYER2, Player);
+        if (sidekick->classID == Player->classID && (self->state == Player_State_Ground || self->state == Player_State_Roll)
+            && (sidekick->state == Player_State_Ground || sidekick->state == Player_State_Roll))
+            MOBILETOUCH_MARK(swapFrame);
+    }
+#endif
+}
+#endif
+
 void Player_Input_P1(void)
 {
     RSDK_THIS(Player);
@@ -6396,6 +6430,10 @@ void Player_Input_P1(void)
             RSDKControllerState *controller = &ControllerInfo[self->controllerID];
             RSDKAnalogState *stick          = &AnalogStickInfoL[self->controllerID];
 
+#if MANIA_MOBILE_TOUCH
+            Player_MobileTouch_Report(self);
+#endif
+
             self->up    = controller->keyUp.down;
             self->down  = controller->keyDown.down;
             self->left  = controller->keyLeft.down;
