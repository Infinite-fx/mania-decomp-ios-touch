--- /dev/null
+++ b/SonicMania/MobileTouchHints.h
@@ -0,0 +1,40 @@
+#ifndef MOBILE_TOUCH_HINTS_H
+#define MOBILE_TOUCH_HINTS_H
+
+// Shared between the game logic and the engine's on-screen touch controls (iOS build only).
+// The game "marks" a field with the current engine frame whenever something is possible
+// (gameplay running, super form available, character swap available, cutscene skippable...).
+// The engine treats a mark as valid for a few frames, so the controls appear/disappear smoothly.
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum MobileTouchModes {
+    MTOUCH_MODE_NONE,
+    MTOUCH_MODE_PLATFORM, // regular gameplay: d-pad + jump (+ contextual buttons)
+    MTOUCH_MODE_SPECIAL,  // UFO / blue sphere stages: d-pad + jump
+    MTOUCH_MODE_PUYO,     // mean bean: d-pad + two rotate buttons
+    MTOUCH_MODE_PINBALL,  // pinball bonus stage: two flipper buttons
+};
+
+typedef struct {
+    unsigned int frame;      // advanced by the engine once per frame
+    unsigned int playFrame;  // last frame a player-1 input routine ran
+    unsigned int superFrame; // last frame super transformation was possible
+    unsigned int swapFrame;  // last frame an encore character swap was possible
+    unsigned int swapAvailFrame; // last frame encore swapping exists at all (a buddy is around)
+    unsigned int skipFrame;  // last frame the running cutscene was skippable
+    unsigned int menuFrame;  // last frame the pause menu was open
+    int mode;
+} MobileTouchHints;
+
+extern MobileTouchHints mobileTouchHints;
+
+#define MOBILETOUCH_MARK(field) (mobileTouchHints.field = mobileTouchHints.frame)
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // MOBILE_TOUCH_HINTS_H
